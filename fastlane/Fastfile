require "tmpdir"
require "fileutils"
require_relative "store_listing"

# Google Play lanes. They run on GitHub Actions, which passes the service account key in the
# PLAY_SERVICE_ACCOUNT_JSON environment variable. Only the listing lane changes the store listing.
# Tracks, from least to most public: internal, alpha (closed testing), beta (open testing), production.
opt_out_usage
default_platform(:android)

platform :android do
  def play_json_key
    key = ENV["PLAY_SERVICE_ACCOUNT_JSON"].to_s
    UI.user_error!("PLAY_SERVICE_ACCOUNT_JSON is not set") if key.strip.empty?
    key
  end

  desc "Check the Play service account can reach PlugBrain, without changing anything"
  lane :validate do
    validate_play_store_json_key(json_key_data: play_json_key)

    # Reading the tracks proves the account was invited to this app in Play Console.
    %w[internal alpha beta production].each do |track|
      codes = google_play_track_version_codes(track: track, json_key_data: play_json_key)
      UI.message("#{track}: #{codes.empty? ? 'no release' : codes.join(', ')}")
    end
  end

  desc "Upload a signed AAB to the internal track as a draft, with each language's changelog as release notes"
  lane :internal do |options|
    aab = File.expand_path(options[:aab] || "../app/build/outputs/bundle/release/app-release.aab", __dir__)
    UI.user_error!("AAB not found: #{aab}") unless File.exist?(aab)
    mapping = File.expand_path(options[:mapping] || "../app/build/outputs/mapping/release/mapping.txt", __dir__)

    play = {
      track: "internal",
      aab: aab,
      # R8 mapping, so Play Console shows readable crash stack traces.
      mapping: (mapping if File.exist?(mapping)),
      json_key_data: play_json_key,
      # Every language that has a changelog for this versionCode; the others get the en-US notes.
      metadata_path: release_notes_dir,
      # Draft until the flow is trusted: press "Review release" in Play Console to roll it out.
      release_status: "draft",
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    }

    # Dry run first, so a rejected bundle (version code, signing key) fails before anything is created.
    upload_to_play_store(**play, validate_only: true)
    upload_to_play_store(**play)
  end

  desc "Copy the latest release of one track to another, e.g. from:internal to:alpha rollout:0.2"
  lane :promote do |options|
    from = options[:from] || UI.user_error!("from: is required")
    to = options[:to] || UI.user_error!("to: is required")
    UI.user_error!("from and to are the same track") if from == to
    fraction = rollout_fraction(options[:rollout])

    upload_to_play_store(
      **no_uploads,
      track: from,
      track_promote_to: to,
      version_code: latest_version_code(from),
      # Below 100% the release starts as a staged rollout; raise it later with the rollout lane.
      track_promote_release_status: fraction < 1 ? "inProgress" : "completed",
      rollout: (fraction.to_s if fraction < 1),
    )
  end

  desc "Change the staged rollout of the latest release on a track, e.g. track:production rollout:0.5 (1 = everyone)"
  lane :rollout do |options|
    track = options[:track] || UI.user_error!("track: is required")
    fraction = rollout_fraction(options[:rollout])
    upload_to_play_store(
      **no_uploads,
      track: track,
      version_code: latest_version_code(track),
      rollout: fraction.to_s,
    )
  end

  desc "Stop a staged rollout on a track. Users who already updated keep the version"
  lane :halt do |options|
    track = options[:track] || UI.user_error!("track: is required")
    upload_to_play_store(
      **no_uploads,
      track: track,
      version_code: latest_version_code(track),
      release_status: "halted",
    )
  end

  desc "Upload the store listing of every locale: title, short and full description, feature graphic, phone screenshots"
  lane :listing do
    problems = StoreListing.problems
    UI.user_error!("Store listing has problems:\n#{problems.join("\n")}") unless problems.empty?

    play = {
      **no_uploads,
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false,
      # Only images whose checksum changed are replaced.
      sync_image_upload: true,
      metadata_path: StoreListing.play_listing_dir(Dir.mktmpdir("play-listing")),
    }
    # Dry run first, so a locale or text Play rejects fails before the listing changes.
    upload_to_play_store(**play, validate_only: true)
    upload_to_play_store(**play)
  end

  def no_uploads
    {
      json_key_data: play_json_key,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    }
  end

  def latest_version_code(track)
    codes = google_play_track_version_codes(track: track, json_key_data: play_json_key)
    UI.user_error!("No release on the #{track} track") if codes.empty?
    codes.max
  end

  def rollout_fraction(value)
    fraction = Float(value || 1)
    UI.user_error!("rollout must be above 0 and at most 1, got #{value}") unless fraction > 0 && fraction <= 1
    fraction
  rescue ArgumentError
    UI.user_error!("rollout must be a number like 0.1, got #{value}")
  end

  def release_notes_dir
    missing = StoreListing.missing_changelogs
    UI.important("No changelog in #{missing.join(', ')}: Play shows them the en-US notes") unless missing.empty?
    StoreListing.release_notes_dir(Dir.mktmpdir("play-notes"))
  rescue RuntimeError => e
    UI.user_error!(e.message)
  end
end
