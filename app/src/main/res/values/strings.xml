    <string name="onboarding_battery_description">Ensures that PlugBrain keeps running reliably even when your device tries to save battery.</string>

    <string name="onboarding_sheet_cta">Understood</string>
    <string name="onboarding_accessibility_disclosure">PlugBrain uses the Accessibility service to see which app is open. When you open an app you chose to block, or a calculator during a challenge, PlugBrain shows a math challenge first.\n\nPlugBrain only reads the app\'s name. It doesn\'t read what\'s on your screen or what you type, and nothing leaves your phone.</string>
    <string name="onboarding_accessibility_accept">Agree and continue</string>
    <string name="onboarding_accessibility_decline">Not now</string>
    <string name="accessibility_service_description">Detects when you open an app you chose to block so PlugBrain can show a math challenge. Only the app\'s name is read.</string>
    <string name="onboarding_sheet_find_app">First, find and select PlugBrain in the list of apps.</string>
