<?xml version="1.0" encoding="UTF-8"?>
<!-- Android Lint settings shared by every module. Run with ./gradlew :app:lintRelease -->
<lint>
    <!-- Dependabot owns dependency versions, so these would only repeat its pull requests. -->
    <issue id="GradleDependency" severity="ignore" />
    <issue id="NewerVersionAvailable" severity="ignore" />
    <issue id="AndroidGradlePluginVersion" severity="ignore" />
    <!-- The SDK bump waits for a Paparazzi release that supports it (dependency plan step 8). -->
    <issue id="OldTargetApi" severity="ignore" />
    <!-- Paparazzi tests use lowercase helper composables, same exception as detekt. -->
    <issue id="ComposableNaming">
        <ignore path="**/src/test/**" />
    </issue>
</lint>
